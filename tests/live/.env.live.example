# Live test suite configuration.
# Copy the relevant values into your real .env (alongside the JIRA_*/CONFLUENCE_* creds),
# then run:  node --env-file=.env tests/live/run-live-suite.mjs
#
# Any test whose required TEST_* var is unset is SKIPped (not failed),
# so you can start with just a project key and add more as you go.

# ── Jira read targets ────────────────────────────────────────────────
TEST_PROJECT_KEY=QT          # drives all the project-scoped analytics/pagination tools
TEST_ISSUE_KEY=QT-1          # an existing issue for get_full_issue/history/links/worklogs/attachments
TEST_BOARD_ID=               # optional: a board id for get_board
TEST_SPRINT_ID=              # optional: a sprint id for get_sprint
TEST_EPIC_KEY=               # optional: an epic key for get_epic_children
TEST_ATTACHMENT_ID=          # optional: an attachment id for get_attachment
TEST_USERNAME_KEY=           # optional: a username key for get_mentions (e.g. jam)
TEST_ASSIGNEE_NAME=          # optional: an assignee name/key for search_by_assignee
TEST_LABEL=mcp-livetest      # label used in search_by_labels and write-flow tagging

# ── Confluence read targets (only used if Confluence is configured) ──
TEST_SPACE_KEY=              # a space key for get_space / page_by_title / search scoping
TEST_PAGE_ID=                # an existing page id for get_page/labels/comments/history/children
TEST_PAGE_TITLE=             # exact page title (with TEST_SPACE_KEY) for get_page_by_title
TEST_CQL=                    # optional: custom CQL for search_pages (defaults to space/type=page)

# ── Mutation flows (OFF by default) ─────────────────────────────────
# RUN_WRITES creates a throwaway Jira issue in TEST_PROJECT_KEY, exercises
# comment/update/attachment, then DELETES it. Use a sandbox project.
RUN_WRITES=0
TEST_ISSUE_TYPE=Task         # issue type used by the write flow's create_issue

# RUN_CONFLUENCE_WRITES creates a page+comment+label in TEST_SPACE_KEY.
# There is NO delete-page tool, so you must remove the page by hand. Use a throwaway space.
RUN_CONFLUENCE_WRITES=0

# ── Tuning ──────────────────────────────────────────────────────────
# LIVE_TEST_TIMEOUT_MS=60000  # per-call RPC timeout in the harness
# REQUEST_TIMEOUT_MS=30000    # server-side upstream timeout (read by the MCP server itself)
